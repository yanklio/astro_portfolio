---
import BaseLayout from "./BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
const { post } = Astro.props;
const frontmatter = post.data;

// For single posts, we'll assign a primary accent like orange.
// If needed, we could generate it from the title hash, but let's stick to orange for consistency with the main theme.
---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="post-container">
        <div class="header-wrapper">
            <BlogCard post={post} isCollapsed={false} />
        </div>

        <article class="post-content">
            <slot />
        </article>
    </div>
</BaseLayout>

<style>
    .post-container {
        max-width: 650px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 2rem;
    }

    .header-wrapper {
        margin-bottom: 2rem;
    }

    .post-content {
        width: 100%;
    }

    .post-content :global(h1) {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-size: 2rem;
        color: var(--fg1);
        border-bottom: 2px solid var(--bg2);
        padding-bottom: 0.5rem;
    }

    .post-content :global(h2) {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-size: 1.5rem;
        color: var(--fg1);
    }

    .post-content :global(h3) {
        margin-top: 1.75rem;
        margin-bottom: 0.5rem;
        font-size: 1.25rem;
        color: var(--fg1);
    }

    .post-content :global(p) {
        margin-bottom: 1.25rem;
        line-height: 1.9;
        font-size: 1rem;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
        line-height: 1.8;
    }

    .post-content :global(li) {
        margin-bottom: 0.5rem;
    }

    .post-content :global(blockquote) {
        margin: 1.5rem 0;
        padding: 1rem 1.5rem;
        border-left: 4px solid var(--orange);
        background-color: var(--bg2);
        color: var(--fg2);
        font-style: italic;
    }

    .post-content :global(code) {
        background-color: var(--bg2);
        padding: 0.2rem 0.5rem;
        border-radius: 3px;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;
        color: var(--orange);
    }

    .post-content :global(pre) {
        background-color: var(--bg2);
        padding: 1.25rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 1px solid var(--fg3);
    }

    .post-content :global(pre code) {
        background-color: transparent;
        padding: 0;
        color: var(--fg1);
    }

    .post-content :global(a) {
        color: var(--orange);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .post-content :global(a:hover) {
        color: var(--fg1);
    }

    @media (max-width: 700px) {
        .post-content {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }
</style>
