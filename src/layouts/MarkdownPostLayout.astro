---
import BaseLayout from "./BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
const { post } = Astro.props;
const frontmatter = post.data;
---

<BaseLayout pageTitle={frontmatter.title} pageDescription={frontmatter.description}>
    <div class="post-container">
        <div class="header-wrapper">
            <BlogCard post={post} isCollapsed={false} />
        </div>

        <article class="post-content">
            <slot />
        </article>
    </div>
</BaseLayout>

<script>
    function initHeaderCards() {
        const article = document.querySelector(".post-content");
        if (!article) return;

        const linkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1M8 13h8v-2H8zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5"/></svg>`;
        const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>`;

        const headers = article.querySelectorAll("h1, h2, h3, h4, h5, h6");
        
        headers.forEach((header) => {
            if (header.parentElement?.classList.contains("header-card")) return;

            const wrapper = document.createElement("div");
            wrapper.className = "header-card paper-border paper-shadow";
            
            const button = document.createElement("button");
            button.className = "copy-btn paper-button";
            button.setAttribute("aria-label", "Copy header link");
            button.innerHTML = linkIcon;
            
            const slug = header.id || header.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || "";
            if (!header.id) header.id = slug;
            
            button.addEventListener("click", async () => {
                const url = `${window.location.origin}${window.location.pathname}#${slug}`;
                await navigator.clipboard.writeText(url);
                button.innerHTML = checkIcon;
                setTimeout(() => {
                    button.innerHTML = linkIcon;
                }, 2000);
            });
            
            header.parentNode?.insertBefore(wrapper, header);
            wrapper.appendChild(header);
            wrapper.appendChild(button);
        });
    }
    
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHeaderCards);
    } else {
        initHeaderCards();
    }

    document.addEventListener("astro:after-swap", initHeaderCards);
</script>

<style>
    .post-container {
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 2rem;
    }

    .header-wrapper {
        margin-bottom: 2rem;
    }

    .post-content {
        width: 100%;
    }

    .post-content :global(h1),
    .post-content :global(h2),
    .post-content :global(h3) {
        color: var(--fg1);
    }

    .post-content :global(h1) {
        margin-top: 2.5rem;
        margin-bottom: 0;
        font-size: 2rem;
        border-bottom: none;
        padding-bottom: 0;
    }

    .post-content :global(h2) {
        margin-top: 2rem;
        margin-bottom: 0;
        font-size: 1.5rem;
    }

    .post-content :global(h3) {
        margin-top: 1.75rem;
        margin-bottom: 0;
        font-size: 1.25rem;
    }

    .post-content :global(p) {
        margin-bottom: 1.25rem;
        line-height: 1.9;
        font-size: 1rem;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
        line-height: 1.8;
    }

    .post-content :global(li) {
        margin-bottom: 0.5rem;
    }

    .post-content :global(blockquote) {
        margin: 1.5rem 0;
        padding: 1rem 1.5rem;
        border-left: 4px solid var(--orange);
        background-color: var(--bg2);
        color: var(--fg2);
        font-style: italic;
    }

    .post-content :global(code) {
        background-color: var(--bg2);
        padding: 0.2rem 0.5rem;
        border-radius: 3px;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;
        color: var(--orange);
    }

    .post-content :global(pre) {
        background-color: var(--bg2);
        padding: 1.25rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 1px solid var(--fg3);
    }

    .post-content :global(pre code) {
        background-color: transparent;
        padding: 0;
        color: var(--fg1);
    }

    .post-content :global(a) {
        color: var(--orange);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .post-content :global(a:hover) {
        color: var(--fg1);
    }

    @media (max-width: 700px) {
        .post-content {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }

    .post-content :global(.header-card) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        margin: 2rem 0 1rem;
        background-color: var(--bg);
    }

    .post-content :global(.header-card h1),
    .post-content :global(.header-card h2),
    .post-content :global(.header-card h3),
    .post-content :global(.header-card h4),
    .post-content :global(.header-card h5),
    .post-content :global(.header-card h6) {
        margin: 0;
        padding: 0;
        border: none;
    }

    .post-content :global(.copy-btn) {
        flex-shrink: 0;
        padding: 0.4rem 0.6rem;
        margin-left: 1rem;
    }
</style>
