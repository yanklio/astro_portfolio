---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import Starfield from "../components/Starfield.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
const { pageTitle = "Yanklio", pageDescription } = Astro.props;
const siteUrl = "https://yanklio.netlify.app";
const siteName = "Yanklio";
const defaultDescription = "Just a website that shows me and also blog posts";
const ogImage = "/og-image.png";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>{pageTitle} | {siteName}</title>
        <meta name="description" content={pageDescription || defaultDescription} />
        <link rel="canonical" href={siteUrl + Astro.url.pathname} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={siteUrl + Astro.url.pathname} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription || defaultDescription} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:image" content={siteUrl + ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription || defaultDescription} />
        <meta name="twitter:image" content={siteUrl + ogImage} />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": siteName,
                    "url": siteUrl,
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${siteUrl}/blog?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    }
                },
                {
                    "@type": "Person",
                    "name": "Yaroslav",
                    "url": siteUrl,
                    "sameAs": [
                        "https://github.com/yanklio",
                        "https://www.linkedin.com/in/yaroslav-u/"
                    ]
                }
            ]
        })} />

        <ClientRouter />
    </head>
    <body>
        <Starfield />
        <Header />

        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        min-height: 100vh;
    }
    main {
        min-height: 80vh;
        padding: 0 16px;
        margin-bottom: 16px;
        margin-top: 128px;
        margin-bottom: 64px;
    }
</style>
