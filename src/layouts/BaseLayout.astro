---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
const { pageTitle = "", pageDescription, pageImage } = Astro.props;
const siteUrl = "https://yanklio.netlify.app";
const siteName = "yanklio";
const defaultDescription = "Personal website and blog of Yaroslav — Full-Stack Developer working with TypeScript, React, Next.js, Node.js, and Python.";
const resolvedTitle = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const ogImage = pageImage || null;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>{resolvedTitle}</title>
        <meta name="description" content={pageDescription || defaultDescription} />
        <link rel="canonical" href={siteUrl + Astro.url.pathname} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={siteUrl + Astro.url.pathname} />
        <meta property="og:title" content={resolvedTitle} />
        <meta property="og:description" content={pageDescription || defaultDescription} />
        <meta property="og:site_name" content={siteName} />
        {ogImage && <meta property="og:image" content={siteUrl + ogImage} />}

        <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={resolvedTitle} />
        <meta name="twitter:description" content={pageDescription || defaultDescription} />
        {ogImage && <meta name="twitter:image" content={siteUrl + ogImage} />}

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": siteName,
                    "url": siteUrl,
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${siteUrl}/blog?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    }
                },
                {
                    "@type": "Person",
                    "name": "Yaroslav",
                    "url": siteUrl,
                    "sameAs": [
                        "https://github.com/yanklio",
                        "https://www.linkedin.com/in/yaroslav-u/"
                    ]
                }
            ]
        })} />

    </head>
    <body>
        <div class="site-shell">
            <aside class="site-rail desktop-only" aria-hidden="true">
                <span class="rail-header">~</span>
            </aside>
            <div class="header-slot">
                <Header />
            </div>
            <main>
                <slot />
            </main>
            <div class="footer-slot">
                <Footer />
            </div>
        </div>
    </body>
</html>

<style>
    body {
        min-height: 100vh;
    }
    .site-shell {
        display: grid;
        grid-template-columns: 3.5rem minmax(0, 1fr);
        grid-template-rows: 4.6rem minmax(70vh, 1fr) 4.6rem;
        min-height: 100vh;
    }
    .site-rail {
        border-right: 2px solid var(--line);
        display: grid;
        font-size: 0.9rem;
        grid-template-rows: 4.6rem minmax(0, 1fr);
        grid-column: 1;
        grid-row: 1 / 3;
        text-align: center;
    }
    .site-rail span {
        align-items: center;
        border-bottom: 2px solid var(--line);
        display: flex;
        justify-content: center;
    }
    .header-slot { align-self: stretch; grid-column: 2; grid-row: 1; min-width: 0; position: sticky; top: 0; z-index: 10; }
    main {
        grid-column: 2;
        grid-row: 2;
        min-width: 0;
        padding: 0 clamp(1.25rem, 4vw, 4rem);
    }
    .footer-slot { grid-column: 1 / 3; grid-row: 3; min-width: 0; }
    @media (max-width: 700px) {
        .site-shell { display: block; }
        .site-rail { display: none; }
        main { padding: 0 1.25rem; }
    }
</style>
