---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
const { pageTitle = "", pageDescription, pageImage } = Astro.props;
const siteUrl = "https://yanklio.netlify.app";
const siteName = "yanklio";
const defaultDescription = "Personal website and blog of Yaroslav — Full-Stack Developer working with TypeScript, React, Next.js, Node.js, and Python.";
const resolvedTitle = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const ogImage = pageImage || null;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>{resolvedTitle}</title>
        <meta name="description" content={pageDescription || defaultDescription} />
        <link rel="canonical" href={siteUrl + Astro.url.pathname} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={siteUrl + Astro.url.pathname} />
        <meta property="og:title" content={resolvedTitle} />
        <meta property="og:description" content={pageDescription || defaultDescription} />
        <meta property="og:site_name" content={siteName} />
        {ogImage && <meta property="og:image" content={siteUrl + ogImage} />}

        <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={resolvedTitle} />
        <meta name="twitter:description" content={pageDescription || defaultDescription} />
        {ogImage && <meta name="twitter:image" content={siteUrl + ogImage} />}

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": siteName,
                    "url": siteUrl,
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${siteUrl}/blog?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    }
                },
                {
                    "@type": "Person",
                    "name": "Yaroslav",
                    "url": siteUrl,
                    "sameAs": [
                        "https://github.com/yanklio",
                        "https://www.linkedin.com/in/yaroslav-u/"
                    ]
                }
            ]
        })} />

        <ClientRouter />
    </head>
    <body>
        <Header />

        <main transition:name="main" transition:animate="fade">
            <slot />
        </main>
        <Footer />
        <script>
            import { initRedirectLoading } from "../scripts/redirect-loading";

            initRedirectLoading();
        </script>
    </body>
</html>

<style>
    body {
        min-height: 100vh;
    }
    main {
        min-height: 80vh;
        padding: 0 16px;
        margin-bottom: 16px;
        margin-top: 128px;
        margin-bottom: 64px;
    }
</style>
