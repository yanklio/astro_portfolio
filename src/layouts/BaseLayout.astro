---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
const { pageTitle, path = Astro.url.pathname } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <ClientRouter />
    </head>
    <body>
        <Header />

        <div class="path-container paper-button">
            <span id="path-text" class="path-text">~{path}</span>
            <button
                class="copy-button"
                aria-label="Copy path"
                title="Copy path"
                data-copy-path
            >
                <Icon name="ic:outline-content-copy" />
            </button>
        </div>
        <main>
            <script>
                document.addEventListener("astro:page-load", () => {
                    const copyButton =
                        document.querySelector("[data-copy-path]");
                    const pathText = document.getElementById("path-text");

                    if (copyButton && pathText) {
                        copyButton.addEventListener("click", async () => {
                            const path = pathText.textContent;
                            try {
                                await navigator.clipboard.writeText(path);
                                copyButton.setAttribute("title", "Copied!");
                                setTimeout(() => {
                                    copyButton.setAttribute(
                                        "title",
                                        "Copy path",
                                    );
                                }, 2000);
                            } catch (err) {
                                console.error("Failed to copy:", err);
                            }
                        });
                    }
                });
            </script>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        min-height: 100vh;
    }
    main {
        margin: auto;
        max-width: 70rem;
        min-height: 90vh;
        padding: 106px 32px 24px 16px;
    }
    .path-container {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 104px;
        margin-left: 16px;
        background-color: var(--green-dim);
        color: var(--fg);
        padding: 8px 16px;
        font-size: 1rem;
        font-family: "JetBrains Mono", monospace;
        margin-bottom: 16px;
        border: 3px solid var(--fg2);
        box-shadow: 4px 4px 0px 0px var(--fg3);
    }
    .path-text {
        font-weight: 700;
    }
    .copy-button {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 2px;
        color: var(--fg);
        font-size: 1.25rem;
    }
</style>
