---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import { site, socialLinks } from "../config/site";
import "../styles/global.css";

interface Props {
    pageDescription?: string;
    pageImage?: string;
    pageTitle?: string;
}

const { pageTitle = "", pageDescription, pageImage } = Astro.props;
const description = pageDescription ?? site.description;
const resolvedTitle = pageTitle ? `${pageTitle} | ${site.handle}` : site.handle;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const ogImage = pageImage ? new URL(pageImage, site.url).href : undefined;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>{resolvedTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={resolvedTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content={site.handle} />
        {ogImage && <meta property="og:image" content={ogImage} />}

        <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={resolvedTitle} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}

        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": site.handle,
                    "url": site.url,
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${site.url}/blog?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    }
                },
                {
                    "@type": "Person",
                    "name": site.name,
                    "url": site.url,
                    "sameAs": socialLinks.map(({ href }) => href)
                }
            ]
        })} />
        <script>import "../scripts/theme";</script>

    </head>
    <body>
        <div class="site-shell">
            <aside class="site-rail desktop-only" aria-hidden="true">
                <span class="rail-header">~</span>
            </aside>
            <div class="header-slot">
                <Header />
            </div>
            <main>
                <slot />
            </main>
            <div class="footer-slot">
                <Footer />
            </div>
        </div>
    </body>
</html>

<style>
    body {
        min-height: 100vh;
    }
    .site-shell {
        display: grid;
        grid-template-columns: 3.5rem minmax(0, 1fr);
        grid-template-rows: 4.6rem minmax(70vh, 1fr) 4.6rem;
        min-height: 100vh;
    }
    .site-rail {
        border-right: 2px solid var(--line);
        display: grid;
        font-size: 0.9rem;
        grid-template-rows: 4.6rem minmax(0, 1fr);
        grid-column: 1;
        grid-row: 1 / 3;
        text-align: center;
    }
    .site-rail span {
        align-items: center;
        border-bottom: 2px solid var(--line);
        display: flex;
        justify-content: center;
    }
    .header-slot { align-self: stretch; grid-column: 2; grid-row: 1; min-width: 0; position: sticky; top: 0; z-index: 10; }
    main {
        grid-column: 2;
        grid-row: 2;
        min-width: 0;
        padding: 0 clamp(1.25rem, 4vw, 4rem);
    }
    .footer-slot { grid-column: 1 / 3; grid-row: 3; min-width: 0; }
    @media (max-width: 700px) {
        .site-shell { display: block; }
        .site-rail { display: none; }
        main { padding: 0 1.25rem; }
    }
</style>
