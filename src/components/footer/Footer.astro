---
import { site } from "../../config/site";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-inner">
        <span>© {currentYear} {site.handle.toUpperCase()}</span>
        <span>Made with love and coffee | v0.8.18</span>
        <span>{site.location}</span>
    </div>
</footer>

<style>
    .site-footer { border-top: 2px solid var(--line); height: 100%; }
    .footer-inner {
        align-items: center;
        color: var(--fg3);
        display: flex;
        font-size: 0.78rem;
        height: 100%;
        justify-content: space-between;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 4vw, 4rem);
        text-transform: uppercase;
    }
    @media (min-width: 701px) {
        .footer-inner { padding-left: calc(3.5rem + clamp(1.25rem, 4vw, 4rem)); }
    }
    @media (max-width: 600px) { .footer-inner { flex-direction: column; gap: 0.45rem; } }
</style>
