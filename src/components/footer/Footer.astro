---
import Logo from "../Logo.astro";
import Sitemap from "./Sitemap.astro";
---

<div class="footer-wrapper">
    <footer>
        <div class="footer-left">
            <span>
                /* Made with love to the software engineering, to creating and
                experimenting with new things. And with a "few" cups of coffee with
                some snacks. */
            </span>
            <br />
            <br />
            <span> @2025 by yanklio </span>
        </div>
        <div class="footer-right">
            <Sitemap />
        </div>
    </footer>
</div>

<style>
    .footer-wrapper {
        width: 100%;
        background: var(--bg);
        border-top: 4px dashed var(--fg3);
    }

    footer {
        width: 100%;
        padding: 32px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }

    .footer-left {
        max-width: 800px;
        text-align: center;
        line-height: 1.6;
        font-family: "JetBrains Mono", monospace;
    }

    .footer-right {
        width: 100%;
        max-width: 800px;
        display: flex;
        justify-content: center;
    }

    span {
        color: var(--fg3);
        font-size: 0.95rem;
    }

    @media (min-width: 768px) {
        footer {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            padding: 48px 32px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .footer-left {
            text-align: left;
            flex: 1;
            padding-right: 48px;
        }

        .footer-right {
            flex: 0 0 auto;
            width: auto;
            justify-content: flex-end;
        }
    }
</style>
