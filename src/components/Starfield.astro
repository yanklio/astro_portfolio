---
const colors = [
    "var(--yellow)",
    "var(--orange)",
    "var(--fg4)", // A soft neutral color to act as the "dim" stars
];

const generateStars = (
    count: number,
    width: number,
    height: number,
    maxSize: number,
) => {
    return Array.from({ length: count }).map(() => ({
        cx: Math.random() * width,
        cy: Math.random() * height,
        r: Math.random() * maxSize + 0.5,
        fill: colors[Math.floor(Math.random() * colors.length)],
    }));
};

// Generate 3 layers of stars. Because they'll be under a glass overlay, we make them brighter.
const starsSm = generateStars(100, 1000, 1000, 1.5);
const starsMd = generateStars(50, 1000, 1000, 2.5);
const starsLg = generateStars(25, 1000, 1000, 4);
---

<div
    id="persistent-starfield"
    class="starfield"
    aria-hidden="true"
    transition:persist="starfield-bg"
>
    <!-- SVG Definitions -->
    <svg width="0" height="0" style="position: absolute; width: 0; height: 0;">
        <defs>
            <pattern
                id="stars-sm"
                x="0"
                y="0"
                width="1000"
                height="1000"
                patternUnits="userSpaceOnUse"
            >
                {
                    starsSm.map((s) => (
                        <text
                            x={s.cx}
                            y={s.cy}
                            fill={s.fill}
                            font-size={s.r * 6 + 6}
                            font-family="monospace"
                            opacity="0.6"
                        >
                            *
                        </text>
                    ))
                }
            </pattern>
            <pattern
                id="stars-md"
                x="0"
                y="0"
                width="1000"
                height="1000"
                patternUnits="userSpaceOnUse"
            >
                {
                    starsMd.map((s) => (
                        <text
                            x={s.cx}
                            y={s.cy}
                            fill={s.fill}
                            font-size={s.r * 6 + 6}
                            font-family="monospace"
                            opacity="0.8"
                        >
                            *
                        </text>
                    ))
                }
            </pattern>
            <pattern
                id="stars-lg"
                x="0"
                y="0"
                width="1000"
                height="1000"
                patternUnits="userSpaceOnUse"
            >
                {
                    starsLg.map((s) => (
                        <text
                            x={s.cx}
                            y={s.cy}
                            fill={s.fill}
                            font-size={s.r * 6 + 6}
                            font-family="monospace"
                            opacity="1.0"
                        >
                            *
                        </text>
                    ))
                }
            </pattern>
        </defs>
    </svg>

    <!-- Parallax Layers -->
    <div class="star-layer" id="layer-sm">
        <svg width="100%" height="100%"
            ><rect width="100%" height="100%" fill="url(#stars-sm)"></rect></svg
        >
    </div>

    <div class="star-layer" id="layer-md">
        <svg width="100%" height="100%"
            ><rect width="100%" height="100%" fill="url(#stars-md)"></rect></svg
        >
    </div>

    <div class="star-layer" id="layer-lg">
        <svg width="100%" height="100%"
            ><rect width="100%" height="100%" fill="url(#stars-lg)"></rect></svg
        >
    </div>

    <!-- The Space Shuttle Glass Overlay over the stars -->
    <div class="glass-overlay"></div>
</div>

<style is:global>
    .starfield {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -10;
        pointer-events: none;
    }

    .star-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        /* Extra height to allow scrolling before snapping back to seamless repeating */
        height: calc(100vh + 1000px);
        transform: translateZ(0); /* Hardware acceleration */
        will-change: transform;
        /* We apply the blur DIRECTLY to the stars to prevent the browser dropping the effect during page transitions */
        filter: blur(1.5px);
    }

    .glass-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;

        /* Simulating the glass tint without heavy backdrop-filter to prevent animation drops */
        /* Increasing opacity to 65% so that the text floating over the stars is easier to read */
        background-color: color-mix(in srgb, var(--bg) 65%, transparent);

        /* The Gruvbox square grid on top of the stars */
        background-size: 40px 40px;
        background-image:
            linear-gradient(
                to right,
                rgba(168, 153, 132, 0.1) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                rgba(168, 153, 132, 0.1) 1px,
                transparent 1px
            );

        z-index: 5; /* Stays above the moving stars but behind the solid content cards */
        pointer-events: none;
        transform: translateZ(0); /* Hardware acceleration */
    }

    /* Light Theme Adjustments:
       Space looks like colorful "dirt" on a light background.
       We increase the background opacity to hide the stars more,
       making them look like subtle, abstract floating geometric particles.
    */
    @media (prefers-color-scheme: light) {
        .star-layer {
            /* Make the particles much fainter in light mode and blurrier */
            opacity: 0.3;
        }

        .glass-overlay {
            /* Make the glass tint "milkier" in light mode */
            background-color: color-mix(in srgb, var(--bg) 85%, transparent);
        }
    }
</style>

<script>
    // Store accumulated offsets globally so they persist across page transitions
    let offsetSm = 0;
    let offsetMd = 0;
    let offsetLg = 0;
    let lastScrollY = typeof window !== "undefined" ? window.scrollY : 0;
    let ticking = false;
    let isInitialized = false;

    function updateParallax() {
        const layerSm = document.getElementById("layer-sm");
        const layerMd = document.getElementById("layer-md");
        const layerLg = document.getElementById("layer-lg");

        if (!layerSm) return;

        const scrollY = window.scrollY;
        const delta = scrollY - lastScrollY;

        // If the delta is extremely large (e.g. jumping to the top of a new page on tab switch),
        // we ignore it so the stars don't violently jump.
        if (Math.abs(delta) < 1000) {
            // Accumulate the offsets. We add 1000000 before modulo to handle negative scroll safely.
            offsetSm = (offsetSm + delta * 0.05 + 1000000) % 1000;
            offsetMd = (offsetMd + delta * 0.15 + 1000000) % 1000;
            offsetLg = (offsetLg + delta * 0.35 + 1000000) % 1000;
        }

        lastScrollY = scrollY;

        if (layerSm)
            layerSm.style.transform = `translate3d(0, -${offsetSm}px, 0)`;
        if (layerMd)
            layerMd.style.transform = `translate3d(0, -${offsetMd}px, 0)`;
        if (layerLg)
            layerLg.style.transform = `translate3d(0, -${offsetLg}px, 0)`;
    }

    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                updateParallax();
                ticking = false;
            });
            ticking = true;
        }
    }

    // Use Astro's page-load event to re-query the DOM elements after navigation
    document.addEventListener("astro:page-load", () => {
        // Reset lastScrollY when initializing (like after a page transition) to prevent initial jumps
        lastScrollY = window.scrollY;

        // Apply immediately
        updateParallax();

        // Attach the global scroll listener ONLY ONCE
        if (!isInitialized) {
            window.addEventListener("scroll", onScroll, { passive: true });
            isInitialized = true;
        }
    });
</script>
