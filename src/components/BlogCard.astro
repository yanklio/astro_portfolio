---
import BlogTag from "./BlogTag.astro";
import { Icon } from "astro-icon/components";
const { post, isCollapsed = true, transitionIndex = 0 } = Astro.props;

const href = isCollapsed ? `/blog/${post.id}` : "/blog";
const iconName = isCollapsed ? "tabler:arrow-right" : "tabler:arrow-left";
const day = post.data.pubDate.toLocaleDateString("en-US", { day: "2-digit" });
const month = post.data.pubDate.toLocaleDateString("en-US", { month: "short" });
const transitionBase = `blog-card-${post.id}`;
---

<div
    class:list={["simple-card paper-border paper-shadow screen-card", { "blog-item-card": isCollapsed, "post-header-card": !isCollapsed }]}
    style={`--card-index: ${transitionIndex}`}
    transition:name={transitionBase}
>
    <div
        class="date-block"
        aria-label={post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        transition:name={`${transitionBase}-date`}
    >
        <span class="date-day">{day}</span>
        <span class="date-month">{month}</span>
    </div>

    <div class="card-content" transition:name={`${transitionBase}-content`}>
        <h2 class="title" transition:name={`${transitionBase}-title`}>{post.data.title}</h2>
        <p class:list={["bio-text", { "blog-description": isCollapsed }]} transition:name={`${transitionBase}-description`}>{post.data.description}</p>
        {
            !isCollapsed && (
                <>
                    <div class="divider" />
                    <div class="blog-tags">
                        {post.data.tags.map((tag: string) => <BlogTag text={tag} slug={tag} />)}
                    </div>
                </>
            )
        }
    </div>

    {
        isCollapsed ? (
            <a href={href} class="read-more-btn paper-button redirect-control" aria-label="Read full post">
                <span class="read-more-label">read post</span>
                <Icon name={iconName} size={24} />
            </a>
        ) : (
            <div class="action-list" aria-label="Article actions">
                <a href={href} class="action-btn paper-button redirect-control" aria-label="Back to blog">
                    <Icon name={iconName} size={24} />
                </a>
                <button class="action-btn paper-button" type="button" data-action="copy-article" aria-label="Copy article as Markdown">
                    <Icon name="tabler:article" size={24} />
                </button>
                <button class="action-btn paper-button" type="button" data-action="share-article" aria-label="Share article">
                    <Icon name="tabler:link" size={24} />
                </button>
            </div>
        )
    }
</div>

<script>
    function setActionFeedback(button: HTMLButtonElement) {
        button.dataset.feedback = "true";
        window.setTimeout(() => {
            button.dataset.feedback = "false";
        }, 1200);
    }

    document.addEventListener("click", async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("[data-action]");
        if (!button) return;

        const action = button.dataset.action;
        const title = document.querySelector(".post-header-card .title")?.textContent?.trim() || document.title;
        const url = window.location.href;

        if (action === "copy-article") {
            const description = document.querySelector(".post-header-card .bio-text")?.textContent?.trim() || "";
            const content = document.querySelector(".post-content")?.textContent?.trim() || "";
            const markdown = [`# ${title}`, description, `Source: ${url}`, content]
                .filter(Boolean)
                .join("\n\n");
            await navigator.clipboard.writeText(markdown);
            setActionFeedback(button);
        }

        if (action === "share-article") {
            if (navigator.share) {
                await navigator.share({ title, url });
            } else {
                await navigator.clipboard.writeText(url);
                setActionFeedback(button);
            }
        }
    });
</script>

<style>
    .simple-card {
        background-color: var(--bg);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: var(--content-width);
        margin: 0 auto;
        position: relative;
    }

    .blog-item-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 2.25rem;
        max-width: var(--content-width);
        min-height: 12rem;
        padding: 2rem 2.25rem;
        overflow: hidden;
    }

    .post-header-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 2.25rem;
        max-width: var(--content-width);
        min-height: 12rem;
        padding: 2rem 2.25rem;
        overflow: hidden;
    }

    .card-content {
        min-width: 0;
        flex: 1 1 auto;
    }

    .date-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
        color: var(--fg1);
        flex: 0 0 7.5rem;
        align-self: stretch;
        background-color: var(--bg_soft);
        border-right: 3px solid var(--orange-dim);
        margin: -2rem 0 -2rem -2.25rem;
        padding: 1rem 0.75rem;
    }

    .date-day {
        font-size: clamp(3.75rem, 7vw, 5rem);
        font-weight: 900;
        letter-spacing: -0.12em;
    }

    .date-month {
        margin-top: 0.75rem;
        font-size: 1.15rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--orange-dim);
    }

    .read-more-btn {
        position: absolute;
        top: 2rem;
        right: 2rem;
        text-decoration: none;
        padding: 0.4rem;
        z-index: 2;
    }

    .read-more-label {
        display: none;
    }

    .blog-item-card .read-more-btn {
        position: static;
        flex: 0 0 4rem;
        align-self: center;
        width: 4rem;
        height: 4rem;
        min-height: 0;
        padding: 0;
    }

    .post-header-card .read-more-btn {
        position: static;
        flex: 0 0 4rem;
        align-self: flex-start;
        padding: 0.6rem;
    }

    .action-list {
        display: flex;
        flex: 0 0 4rem;
        flex-direction: column;
        align-self: stretch;
        justify-content: flex-start;
        gap: 0.8rem;
    }

    .action-btn {
        width: 4rem;
        height: 4rem;
        padding: 0;
        text-decoration: none;
    }

    .action-label {
        display: none;
    }

    .action-btn[data-feedback="true"] {
        background-color: var(--bg2);
    }



    .blog-item-card .read-more-btn :global(svg) {
        width: 1.65rem;
        height: 1.65rem;
    }

    .post-header-card .read-more-btn :global(svg) {
        width: 1.75rem;
        height: 1.75rem;
    }

    .action-btn :global(svg) {
        width: 1.65rem;
        height: 1.65rem;
    }

    .label {
        font-size: 0.85rem;
        color: var(--fg4);
        letter-spacing: 2px;
        text-transform: uppercase;
        font-family: inherit;
        margin: 0 0 0.5rem 0;
        padding-right: 3rem; /* Leave space for absolute button */
    }

    .title {
        font-size: 1.25rem;
        line-height: 1.05;
        margin: 0 0 1.15rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--fg1);
        padding-right: 0;
    }

    .post-header-card .title {
        padding-right: 0;
    }

    .divider {
        width: 100%;
        height: 2px;
        background-color: var(--fg3);
        margin: 1.5rem 0;
    }

    .bio-text {
        font-size: 1rem;
        line-height: 1.45;
        color: var(--fg2);
        margin: 0;
    }

    .blog-description {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: auto;
        justify-content: flex-start;
        align-items: flex-start;
        align-self: flex-start;
        width: 100%;
    }

    @media (max-width: 700px) {
        .simple-card {
            padding: 1.5rem;
        }

        .blog-item-card {
            flex-direction: column;
            align-items: stretch;
            gap: 2.25rem;
            min-height: auto;
            padding: 1.5rem;
        }

        .post-header-card {
            flex-direction: column;
            align-items: stretch;
            padding: 1.5rem;
            min-height: auto;
        }

        .date-block {
            flex-basis: auto;
            align-self: auto;
            border-right: none;
            border-bottom: none;
            margin: 0;
            padding: 0;
        }

        .read-more-btn {
            top: 1rem;
            right: 1rem;
        }

        .blog-item-card .date-block {
            width: auto;
            flex-direction: row;
            align-items: baseline;
            justify-content: center;
            gap: 0.65rem;
            background-color: var(--bg_soft);
            border-right: none;
            border-bottom: 3px solid var(--orange-dim);
            color: var(--fg1);
            margin: -1.5rem -1.5rem 0;
            padding: 1rem 1.5rem 0.85rem;
        }

        .blog-item-card .card-content {
            align-self: auto;
        }

        .blog-item-card .read-more-btn {
            align-self: stretch;
            width: 100%;
            height: 2.8rem;
            min-height: 0;
            padding: 0 1rem;
            justify-content: space-between;
        }

        .blog-item-card .read-more-btn:active {
            box-shadow: 1px 1px 0px 0px light-dark(var(--fg1), var(--fg3));
        }

        .blog-item-card .read-more-label {
            display: inline;
            color: var(--fg1);
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: lowercase;
        }

        .blog-item-card .read-more-btn :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
        }

        .post-header-card .date-block {
            width: auto;
            flex-direction: row;
            align-items: baseline;
            justify-content: center;
            gap: 0.65rem;
            background-color: var(--bg_soft);
            border-bottom: 3px solid var(--orange-dim);
            color: var(--fg1);
            margin: -1.5rem -1.5rem 0;
            padding: 1rem 1.5rem 0.85rem;
        }

        .post-header-card .date-day {
            font-size: 2.35rem;
            letter-spacing: -0.08em;
        }

        .post-header-card .date-month {
            margin-top: 0;
            font-size: 0.95rem;
        }

        .action-list {
            flex-basis: auto;
            flex-direction: row;
            align-self: stretch;
            justify-content: stretch;
            width: 100%;
            padding-top: 0.25rem;
        }

        .action-btn {
            flex: 1 1 0;
            width: auto;
            height: 3.5rem;
        }

        .title {
            font-size: 1.05rem;
            line-height: 1.12;
            margin-bottom: 0.75rem;
            padding-right: 0;
        }

        .post-header-card .title {
            padding-right: 0;
        }

        .bio-text {
            font-size: 0.92rem;
            line-height: 1.45;
        }

        .date-day {
            font-size: 2.35rem;
            letter-spacing: -0.08em;
        }

        .date-month {
            margin-top: 0;
            font-size: 0.95rem;
        }

        .label {
            padding-right: 2rem;
        }
    }

    @media (max-width: 430px) {
        .blog-item-card {
            gap: 2.25rem;
            padding: 1.5rem;
        }

        .blog-item-card .read-more-btn {
            height: 2.8rem;
        }

        .blog-description {
            -webkit-line-clamp: 3;
        }
    }
</style>
