---
const { post } = Astro.props;
---

<a href={`/posts/${post.id}`} class="blog-card-link">
    <article class="blog-card paper-border paper-shadow paper-animation">
        <div class="blog-card-image-container">
            <img
                src={post.data.image.url}
                alt={post.data.image.alt}
                class="blog-card-image"
            />
        </div>
        <div class="blog-card-content">
            <h2 class="blog-card-title">{post.data.title}</h2>
            <p class="blog-card-description">{post.data.description}</p>
            <div class="blog-card-meta">
                <time class="blog-card-date">
                    {post.data.pubDate.toLocaleDateString()}
                </time>
                <span class="blog-card-author">
                    {post.data.author}
                </span>
            </div>
            <div class="blog-card-tags">
                {post.data.tags.map((tag: string) => (
                    <span class="blog-card-tag">{tag}</span>
                ))}
            </div>
        </div>
    </article>
</a>

<style>
    .blog-card-link {
        text-decoration: none;
        display: block;
    }

    .blog-card {
        background-color: var(--bg);
        transition: background-color 0.2s ease;
        cursor: pointer;
        max-width: 350px;
    }

    .blog-card-image-container {
        width: 100%;
        height: 140px;
        overflow: hidden;
        border-bottom: 3px solid var(--fg2);
    }

    .blog-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .blog-card-content {
        padding: 1rem;
    }

    .blog-card-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.1rem;
        color: var(--fg1);
    }

    .blog-card:hover {
        background-color: var(--bg_soft);
    }

    .blog-card-image-container {
        width: 100%;
        height: 200px;
        overflow: hidden;
        border-bottom: 3px solid var(--fg2);
    }

    .blog-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .blog-card-content {
        padding: 1.5rem;
    }

    .blog-card-title {
        margin: 0 0 0.75rem 0;
        font-size: 1.5rem;
        color: var(--fg1);
    }

    .blog-card-description {
        margin: 0 0 1rem 0;
        color: var(--fg3);
        line-height: 1.5;
    }

    .blog-card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        font-size: 0.875rem;
        color: var(--fg3);
    }

    .blog-card-date {
        font-weight: 500;
    }

    .blog-card-author {
        font-weight: 500;
    }

    .blog-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .blog-card-tag {
        padding: 0.25rem 0.75rem;
        background-color: var(--bg2);
        border: 2px solid var(--fg3);
        font-size: 0.75rem;
        color: var(--fg3);
    }

    @media (max-width: 768px) {
        .blog-card-image-container {
            height: 150px;
        }

        .blog-card-title {
            font-size: 1.25rem;
        }

        .blog-card-content {
            padding: 1rem;
        }
    }
</style>
