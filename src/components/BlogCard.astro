---
import BlogTag from "./BlogTag.astro";
import { Icon } from "astro-icon/components";
const { post } = Astro.props;
---

<div class="simple-card paper-border paper-shadow">
    <a href={`/blog/${post.id}`} class="read-more-btn paper-button" aria-label="Read full post">
        <Icon name="ic:baseline-arrow-forward" size={24} />
    </a>
    <span class="label">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </span>
    <h2 class="title">{post.data.title}</h2>
    <p class="bio-text blog-description">{post.data.description}</p>
    <div class="divider"></div>
    <div class="blog-tags">
        {post.data.tags.map((tag: string) => <BlogTag text={tag} slug={tag} />)}
    </div>
</div>

<style>
    .simple-card {
        background-color: var(--bg);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
        position: relative;
    }

    .read-more-btn {
        position: absolute;
        top: 2rem;
        right: 2rem;
        text-decoration: none;
        padding: 0.4rem;
        z-index: 2;
    }

    .label {
        font-size: 0.85rem;
        color: var(--fg4);
        letter-spacing: 2px;
        text-transform: uppercase;
        font-family: inherit;
        margin: 0 0 0.5rem 0;
        padding-right: 3rem; /* Leave space for absolute button */
    }

    .title {
        font-size: 2.5rem;
        line-height: 1.1;
        margin: 0 0 0.5rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--fg1);
        padding-right: 2rem; /* Leave space for absolute button */
    }

    .divider {
        width: 100%;
        height: 2px;
        background-color: var(--fg3);
        margin: 1.5rem 0;
    }

    .bio-text {
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--fg1);
        margin: 0;
    }

    .blog-description {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: auto;
        justify-content: flex-start;
        align-items: flex-start;
        align-self: flex-start;
        width: 100%;
    }

    @media (max-width: 600px) {
        .simple-card {
            padding: 1.5rem;
        }
        .read-more-btn {
            top: 1rem;
            right: 1rem;
        }
        .title {
            font-size: 2rem;
            padding-right: 2rem;
        }
        .label {
            padding-right: 2rem;
        }
    }
</style>
