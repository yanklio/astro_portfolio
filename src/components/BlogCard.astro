---
const { post } = Astro.props;
---

<a href={`/posts/${post.id}`} class="blog-card-link">
    <article class="blog-card paper-border paper-shadow paper-animation">
        <div class="blog-card-image-container">
            <img
                src={post.data.image.url}
                alt={post.data.image.alt}
                class="blog-card-image"
            />
        </div>
        <div class="blog-card-content">
            <h2 class="blog-card-title">{post.data.title}</h2>
            <p class="blog-card-description">{post.data.description}</p>
            <div class="blog-card-meta">
                <time class="blog-card-date">
                    {post.data.pubDate.toLocaleDateString()}
                </time>
                <span class="blog-card-author">
                    {post.data.author}
                </span>
            </div>
            <div class="blog-card-tags">
                {
                    post.data.tags.map((tag: string) => (
                        <span class="blog-card-tag">{tag}</span>
                    ))
                }
            </div>
        </div>
    </article>
</a>

<style>
    .blog-card-link {
        text-decoration: none;
        display: block;
    }

    .blog-card {
        background-color: var(--bg);
        transition: background-color 0.2s ease;
        cursor: pointer;
        max-width: 300px;
        height: 350px;
        display: flex;
        flex-direction: column;
    }

    .blog-card:hover {
        background-color: var(--bg_soft);
    }

    .blog-card-image-container {
        width: 100%;
        height: 140px;
        flex-shrink: 0;
        overflow: hidden;
        border-bottom: 3px solid var(--fg2);
    }

    .blog-card-image {
        width: 100%;
        height: 100%;
        object-fit: fill;
    }

    .blog-card-content {
        padding: 1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .blog-card-title {
        margin: 0 0 0.5rem 0;
        font-size: 1rem;
        color: var(--fg1);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card-description {
        margin: 0 0 0.75rem 0;
        color: var(--fg3);
        line-height: 1.4;
        font-size: 0.875rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        font-size: 0.75rem;
        color: var(--fg3);
        flex-shrink: 0;
    }

    .blog-card-date {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card-author {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        overflow: hidden;
        flex-shrink: 0;
    }

    .blog-card-tag {
        padding: 0.3rem 0.6rem;
        background-color: var(--bg2);
        border: 2px solid var(--fg2);
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--fg2);
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .blog-card-tag:hover {
        background-color: var(--fg2);
        color: var(--bg);
    }
</style>
