---
import { Icon } from "astro-icon/components";
---

<a class="paper-button rss-button" href="/rss.xml" aria-label="RSS Feed">
    <Icon name="tabler:rss" />
    <span class="rss-text">feed</span>
</a>

<style>
    .rss-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 104px;
        height: 46px;
        font-size: 1.2rem;
        text-decoration: none;
        color: var(--fg1);
    }
    .rss-button :global(svg) {
        color: var(--orange-dim);
    }
    .rss-button:hover {
        background-color: var(--bg2);
    }
    .rss-button:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0px 0px var(--fg3);
    }
    .rss-text {
            margin-left: 8px;
        }
</style>
