---
import { Icon } from "astro-icon/components";
---

<button
    class="theme-toggle paper-button"
    aria-label="Toggle theme"
    type="button"
    data-theme-toggle
>
    <Icon class="icon sun" name="ic:baseline-wb-sunny" />
    <Icon class="icon moon" name="ic:baseline-dark-mode" />
</button>

<style>
    .theme-toggle {
        background: var(--aqua);
        color: var(--bg);
        width: 2.55rem;
        height: 2.55rem;
        padding: 0;
        font-size: 1.3rem;
        cursor: pointer;
    }

    .theme-toggle:hover {
        background: var(--aqua-dim);
    }

    .moon {
        display: none;
    }

    :global(.dark) .sun {
        display: none;
    }
    :global(html.dark) .moon {
        display: block;
    }
</style>
