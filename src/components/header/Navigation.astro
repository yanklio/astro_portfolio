---
const currentPath = Astro.url.pathname;
---

<nav class="navigation">
    <div class="nav-container paper-border">
        <a
            href="/"
            class:list={[
                "nav-link paper-animation",
                { active: currentPath === "/" },
            ]}>/about</a
        >
        <!-- <a
            href="/projects"
            class:list={["nav-link", { active: currentPath === "/projects" }]}
            >/projects</a
        > -->
        <a
            href="/blog"
            class:list={[
                "nav-link paper-animation",
                {
                    active:
                        currentPath === "/blog" ||
                        currentPath.startsWith("/blog/"),
                },
            ]}>/blog</a
        >
        <!-- <a
            href="/contact"
            class:list={["nav-link", { active: currentPath === "/contact" }]}
            >/contact</a
        > -->
    </div>
</nav>

<style>
    .navigation {
        height: 50px;
    }

    .nav-container {
        display: flex;
        background-color: var(--bg);
        overflow: visible;
    }

    .nav-link {
        padding: 4px 16px;
        margin: 6px 6px;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--fg1);
        background-color: var(--bg_soft);
        transition: all 0.05s ease;
        border: 2px solid var(--fg1);
        box-shadow: 3px 3px 0px 0px var(--fg3);
    }

    .nav-link:hover {
        background-color: var(--bg2);
    }

    .nav-link:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0px 0px var(--fg3);
    }

    .nav-link.active {
        background-color: var(--yellow-dim);
        color: var(--black);
        font-weight: 600;
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0px 0px var(--fg3);
    }

    .nav-link.pressing {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0px 0px var(--fg3);
        transition: none;
    }
</style>

<script is:inline>
    document.querySelectorAll(".nav-link").forEach((link) => {
        link.addEventListener("pointerdown", () => {
            link.classList.add("pressing");
        });
    });
</script>
