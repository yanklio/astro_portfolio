---
const currentPath = Astro.url.pathname;
const blogActive = currentPath === "/blog" || currentPath.startsWith("/blog/");
---

<nav class="navigation" aria-label="Primary navigation">
    <a href="/" class:list={["nav-link", { active: currentPath === "/" }]}>About</a>
    <a href="/blog" class:list={["nav-link", { active: blogActive }]}>Notes</a>
</nav>

<style>
    .navigation { display: flex; gap: 0.45rem; }
    .nav-link {
        border: 2px solid var(--fg1);
        box-shadow: 3px 3px 0 var(--fg1);
        color: var(--fg1);
        background: var(--bg_hard);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.55rem 0.85rem;
        text-decoration: none;
        text-transform: uppercase;
    }
    .nav-link:hover { background: var(--bg2); }
    .nav-link:active { box-shadow: 0 0 0 var(--fg1); transform: translate(3px, 3px); }
    .nav-link.active { background: var(--nav-accent); color: var(--black); pointer-events: none; }
</style>
