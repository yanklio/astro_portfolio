---
const currentPath = Astro.url.pathname;
import Logo from "../Logo.astro";
import Navigation from "./Navigation.astro";
import RSSButton from "./RSSButton.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { Icon } from "astro-icon/components";
---

<header>
    <nav>
        <Logo />
        <div class="desktop-only">
            <Navigation />
        </div>

        <div class="desktop-only">
            <div class="single-row">
                <RSSButton />
                <ThemeIcon />
            </div>
        </div>

        <div class="mobile-only">
            <button
                id="mobileMenuToggle"
                class="mobile-menu-btn paper-button"
                aria-label="Toggle menu"
            >
                <Icon name="tabler:menu-2" class="menu-toggle-icon" />
                <Icon name="tabler:x" class="menu-close-icon" />
            </button>
        </div>
    </nav>

    <div id="mobileMenu" class="mobile-menu mobile-only">
        <div class="mobile-menu-inner">
            <div
                class:list={["menu-item", { "hidden-route": currentPath === "/" }]}
            >
            <a
                href="/"
                class:list={["menu-link", { active: currentPath === "/" }]}
            >
                <div class="menu-content">
                    <div class="menu-title">/about</div>
                    <div class="menu-desc">Navigate to home page</div>
                </div>
                <Icon name="tabler:home" class="menu-icon" />
            </a>
        </div>
        <div
            class:list={[
                "menu-item",
                {
                    "hidden-route":
                        currentPath === "/blog" ||
                        currentPath.startsWith("/blog/"),
                },
            ]}
        >
            <a
                href="/blog"
                class:list={[
                    "menu-link",
                    {
                        active:
                            currentPath === "/blog" ||
                            currentPath.startsWith("/blog/"),
                    },
                ]}
            >
                <div class="menu-content">
                    <div class="menu-title">/blog</div>
                    <div class="menu-desc">Read blog posts</div>
                </div>
                <Icon name="tabler:article" class="menu-icon" />
            </a>
        </div>
        <div class="menu-divider"></div>
        <div class="menu-item">
            <button id="copyRSS" class="menu-link">
                <div class="menu-content">
                    <div class="menu-title">RSS Feed</div>
                    <div class="menu-desc">Copy feed URL to clipboard</div>
                </div>
                <Icon name="tabler:rss" class="menu-icon" />
            </button>
        </div>
        <div class="menu-item">
            <button id="mobileThemeToggle" class="menu-link">
                <div class="menu-content">
                    <div class="menu-title">Theme</div>
                    <div class="menu-desc">
                        Switch between light and dark mode
                    </div>
                </div>
                <div class="theme-icons">
                    <Icon
                        class="icon sun menu-icon"
                        name="tabler:sun"
                    />
                    <Icon
                        class="icon moon menu-icon"
                        name="tabler:moon"
                    />
                </div>
            </button>
        </div>
        </div>
    </div>

</header>

<div id="menuOverlay" class="menu-overlay mobile-only"></div>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 1000;
    }

    nav {
        min-height: 82px;

        background-color: var(--bg_soft);
        border-bottom: 4px solid var(--fg2);
        width: 100%;

        padding: 2px 16px;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .single-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mobile-menu-btn {
        height: 50px;
        padding: 0 16px;
        font-size: 1.5rem;
        background: var(--bg1);

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .menu-toggle-icon {
        display: block;
    }

    .menu-close-icon {
        display: none;
    }

    .mobile-menu-btn.open .menu-toggle-icon {
        display: none;
    }

    .mobile-menu-btn.open .menu-close-icon {
        display: block;
    }

    .mobile-menu {
        width: 100%;
        max-height: 0;
        background-color: var(--bg_soft);
        overflow: hidden;
        transition: max-height 0.3s ease;
        border-bottom: 0px solid var(--fg2);
        box-shadow: none;
    }

    .mobile-menu.open {
        max-height: 80vh;
        border-bottom: 4px solid var(--fg2);
        box-shadow: 0px 4px 0px 0px light-dark(var(--fg3), var(--bg4));
    }

    .mobile-menu-inner {
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        overflow-y: auto;
        max-height: 80vh;
    }

    .menu-item {
        width: 100%;
    }

    .menu-item.hidden-route {
        display: none;
    }

    .menu-link {
        width: 100%;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bg);
        color: var(--fg1);
        text-decoration: none;
        font-size: 1rem;
        font-family: inherit;
        cursor: pointer;
        
        border: 3px solid light-dark(var(--fg2), var(--bg3));
        box-shadow: 4px 4px 0px 0px light-dark(var(--fg3), var(--bg4));
        transition: all 0.05s ease;
    }

    .menu-link:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0px 0px light-dark(var(--fg3), var(--bg4));
    }

    .menu-link:hover {
        background-color: var(--bg2);
    }

    .menu-link.active {
        background-color: var(--yellow-dim);
        color: var(--black);
        font-weight: 600;
        border-color: var(--orange);
    }

    .menu-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        text-align: left;
    }

    .menu-title {
        font-size: 1.3rem;
        font-weight: bold;
        text-transform: lowercase;
        color: var(--fg1);
    }

    .menu-link.active .menu-title {
        color: var(--black);
    }

    .menu-desc {
        font-size: 0.95rem;
        color: var(--fg2);
        font-weight: normal;
        text-transform: none;
    }

    .menu-link.active .menu-desc {
        color: var(--black);
        opacity: 0.8;
    }

    .menu-divider {
        display: none;
    }

    .theme-icons {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .menu-icon {
        font-size: 2rem;
        color: var(--fg1);
    }

    .menu-link.active .menu-icon {
        color: var(--black);
    }

    .theme-icons .moon {
        display: none;
    }

    :global(.dark) .theme-icons .sun {
        display: none;
    }

    :global(html.dark) .theme-icons .moon {
        display: block;
    }

    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--black);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 999;
    }

    .menu-overlay.open {
        opacity: 0.8;
        pointer-events: auto;
    }
</style>

<script>
    function setupMobileMenu() {
        const mobileMenu = document.getElementById("mobileMenu");
        const mobileMenuToggle = document.getElementById("mobileMenuToggle");
        const menuOverlay = document.getElementById("menuOverlay");
        const copyRSS = document.getElementById("copyRSS");
        const mobileThemeToggle = document.getElementById("mobileThemeToggle");
        const menuLinks = mobileMenu?.querySelectorAll(".menu-link");

        function closeMenu() {
            mobileMenu?.classList.remove("open");
            menuOverlay?.classList.remove("open");
            mobileMenuToggle?.classList.remove("open");
        }

        function openMenu() {
            mobileMenu?.classList.add("open");
            menuOverlay?.classList.add("open");
            mobileMenuToggle?.classList.add("open");
        }

        mobileMenuToggle?.addEventListener("click", () => {
            if (mobileMenu?.classList.contains("open")) {
                closeMenu();
            } else {
                openMenu();
            }
            mobileMenuToggle?.blur();
        });

        menuOverlay?.addEventListener("click", closeMenu);

        menuLinks?.forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        copyRSS?.addEventListener("click", () => {
            navigator.clipboard.writeText(window.location.origin + "/rss.xml");
            closeMenu();
        });

        mobileThemeToggle?.addEventListener("click", () => {
            const element = document.documentElement;
            element.classList.toggle("dark");
            const isDark = element.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            closeMenu();
        });
    }

    setupMobileMenu();
    document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
