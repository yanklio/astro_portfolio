---
import Logo from "../Logo.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
const blogActive = currentPath === "/blog" || currentPath.startsWith("/blog/");
---

<header class="site-header">
    <div class="header-inner">
        <Logo />
        <div class="desktop-only header-desktop">
            <Navigation />
            <div class="header-actions"><ThemeIcon /></div>
        </div>
        <button id="mobileMenuToggle" class="mobile-menu-btn mobile-only paper-button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open navigation">
            <span class="menu-open-icon"><Icon name="ic:menu" /></span>
            <span class="menu-close-icon"><Icon name="ic:close" /></span>
        </button>
    </div>
    <div id="mobileMenu" class="mobile-menu mobile-only">
        <nav class="mobile-nav" aria-label="Mobile navigation">
            <a href="/" class:list={["mobile-nav-link", { active: currentPath === "/" }]}>About</a>
            <a href="/blog" class:list={["mobile-nav-link", { active: blogActive }]}>Notes</a>
            <button id="mobileThemeToggle" class="mobile-nav-link" type="button">Theme</button>
        </nav>
    </div>
</header>

<style>
    .site-header { background: var(--bg); border-bottom: 2px solid var(--line); min-height: 4.6rem; }
    .header-inner {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin: 0 auto;
        height: calc(4.6rem - 2px);
        padding: 0 clamp(1.25rem, 4vw, 4rem);
    }
    .header-desktop { align-items: center; display: flex; gap: 1.5rem; }
    .header-actions { align-items: center; display: flex; gap: 0.6rem; }
    .mobile-menu-btn { height: 2.8rem; padding: 0; width: 2.8rem; }
    .mobile-menu-btn :global(svg) { height: 1.45rem; width: 1.45rem; }
    .menu-close-icon { display: none; }
    .mobile-menu-btn[aria-expanded="true"] .menu-open-icon { display: none; }
    .mobile-menu-btn[aria-expanded="true"] .menu-close-icon { display: flex; }
    .mobile-menu { display: none; margin: 0 auto; }
    .mobile-menu.open { display: block; }
    .mobile-nav { display: grid; gap: 0.65rem; padding: 1rem 1.25rem; }
    .mobile-nav-link {
        background: var(--bg_hard);
        border: 3px solid var(--fg1);
        box-shadow: 3px 3px 0 var(--fg1);
        color: var(--fg1);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.8rem 1rem;
        text-align: left;
        text-decoration: none;
        text-transform: uppercase;
    }
    .mobile-nav-link.active { background: var(--yellow-dim); color: var(--black); }
    .mobile-nav-link:active { box-shadow: 0 0 0 var(--fg1); transform: translate(3px, 3px); }
    @media (max-width: 700px) {
        .header-desktop { display: none; }
    }
</style>

<script>
    function setupMobileMenu() {
        const toggle = document.getElementById("mobileMenuToggle");
        const menu = document.getElementById("mobileMenu");
        const theme = document.getElementById("mobileThemeToggle");
        const close = () => {
            menu?.classList.remove("open");
            toggle?.setAttribute("aria-expanded", "false");
            toggle?.setAttribute("aria-label", "Open navigation");
        };

        toggle?.addEventListener("click", () => {
            const open = menu?.classList.toggle("open") ?? false;
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        });
        menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
        theme?.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
            close();
        });
    }
    setupMobileMenu();
</script>
