---
const currentPath = Astro.url.pathname;
import Logo from "../Logo.astro";
import Navigation from "./Navigation.astro";
import RSSButton from "./RSSButton.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { Icon } from "astro-icon/components";
---

<header>
    <nav>
        <Logo />
        <div class="desktop-only">
            <Navigation />
        </div>

        <div class="desktop-only">
            <div class="single-row">
                <RSSButton />
                <ThemeIcon />
            </div>
        </div>

        <div class="mobile-only">
            <button
                id="mobileMenuToggle"
                class="mobile-menu-btn paper-button"
                aria-label="Toggle menu"
            >
                <Icon name="tabler:menu-2" class="menu-toggle-icon" />
                <Icon name="tabler:x" class="menu-close-icon" />
            </button>
        </div>
    </nav>

    <div id="mobileMenu" class="mobile-menu mobile-only">
        <div class="mobile-menu-inner">
            <div class="menu-section">
                <span class="menu-section-label">// pages</span>
                <div
                    class:list={[
                        "menu-item",
                        { "hidden-route": currentPath === "/" },
                    ]}
                >
                    <a
                        href="/"
                        class:list={[
                            "menu-link redirect-control",
                            { active: currentPath === "/" },
                        ]}
                    >
                        <Icon name="tabler:home" class="menu-icon" />
                        <div class="menu-content">
                            <div class="menu-title">/about</div>
                        </div>
                    </a>
                </div>
                <div
                    class:list={[
                        "menu-item",
                        {
                            "hidden-route":
                                currentPath === "/blog" ||
                                currentPath.startsWith("/blog/"),
                        },
                    ]}
                >
                    <a
                        href="/blog"
                        class:list={[
                            "menu-link redirect-control",
                            {
                                active:
                                    currentPath === "/blog" ||
                                    currentPath.startsWith("/blog/"),
                            },
                        ]}
                    >
                        <Icon name="tabler:article" class="menu-icon" />
                        <div class="menu-content">
                            <div class="menu-title">/blog</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="menu-section menu-section-controls">
                <span class="menu-section-label">// controls</span>
                <div class="menu-item">
                    <button id="copyRSS" class="menu-link menu-action">
                        <Icon name="tabler:rss" class="menu-icon" />
                        <div class="menu-content">
                            <div class="menu-title">rss</div>
                        </div>
                    </button>
                </div>
                <div class="menu-item">
                    <button id="mobileThemeToggle" class="menu-link menu-action">
                        <span class="theme-icons">
                            <Icon
                                class="icon sun menu-icon"
                                name="tabler:sun"
                            />
                            <Icon
                                class="icon moon menu-icon"
                                name="tabler:moon"
                            />
                        </span>
                        <div class="menu-content">
                            <div class="menu-title">theme</div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

</header>

<div id="menuOverlay" class="menu-overlay mobile-only"></div>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 1000;
    }

    nav {
        min-height: 82px;

        background-color: var(--bg_soft);
        border-bottom: 4px solid var(--fg2);
        width: 100%;

        padding: 2px 16px;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .single-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mobile-menu-btn {
        height: 50px;
        padding: 0 16px;
        font-size: 1.5rem;
        background: var(--bg_soft);

        display: flex;
        justify-content: center;
        align-items: center;
    }

    .mobile-menu-btn.open {
        background: var(--yellow-dim);
    }

    .menu-toggle-icon {
        display: block;
    }

    .menu-close-icon {
        display: none;
    }

    .mobile-menu-btn.open .menu-toggle-icon {
        display: none;
    }

    .mobile-menu-btn.open .menu-close-icon {
        display: block;
    }

    .mobile-menu {
        width: 100%;
        max-height: 0;
        background-color: var(--bg_soft);
        overflow: hidden;
        transition: max-height 0.3s ease;
        border-bottom: 0px solid var(--fg2);
        box-shadow: none;
    }

    .mobile-menu.open {
        max-height: 80vh;
        border-bottom: 4px solid var(--fg2);
        box-shadow: 0px 4px 0px 0px light-dark(var(--fg3), var(--bg4));
    }

    .mobile-menu-inner {
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 22px;
        overflow-y: auto;
        max-height: 80vh;
    }

    .menu-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .menu-section-label {
        color: var(--orange-dim);
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .menu-item {
        width: 100%;
    }

    .menu-item.hidden-route {
        display: none;
    }

    .menu-link {
        width: 100%;
        min-height: 72px;
        padding: 16px 18px;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 16px;
        background: var(--bg1);
        color: var(--fg1);
        text-decoration: none;
        font-size: 1rem;
        font-family: inherit;
        cursor: pointer;

        border: 2px solid light-dark(var(--fg2), var(--bg3));
        box-shadow: 3px 3px 0px 0px light-dark(var(--fg3), var(--bg4));
        transition: none;
    }

    .menu-action {
        background: var(--bg);
    }

    .menu-link:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0px 0px light-dark(var(--fg1), var(--fg3));
    }

    .menu-link:hover {
        background-color: light-dark(var(--bg3), var(--bg4));
    }

    .menu-link.active {
        background-color: var(--yellow-dim);
        color: var(--black);
        font-weight: 600;
        border-color: var(--orange);
    }

    .menu-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .menu-title {
        font-size: 1.25rem;
        font-weight: bold;
        line-height: 1;
        text-transform: lowercase;
        color: var(--fg1);
    }

    .menu-link.active .menu-title {
        color: var(--black);
    }

    .theme-icons {
        width: 28px;
        flex: 0 0 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .menu-icon {
        flex: 0 0 28px;
        font-size: 1.75rem;
        color: var(--fg1);
    }

    .menu-link.active .menu-icon {
        color: var(--black);
    }

    .theme-icons .moon {
        display: none;
    }

    :global(.dark) .theme-icons .sun {
        display: none;
    }

    :global(html.dark) .theme-icons .moon {
        display: block;
    }

    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--black);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 999;
    }

    .menu-overlay.open {
        opacity: 0.8;
        pointer-events: auto;
    }
</style>

<script>
    function setupMobileMenu() {
        const mobileMenu = document.getElementById("mobileMenu");
        const mobileMenuToggle = document.getElementById("mobileMenuToggle");
        const menuOverlay = document.getElementById("menuOverlay");
        const copyRSS = document.getElementById("copyRSS");
        const mobileThemeToggle = document.getElementById("mobileThemeToggle");

        function closeMenu() {
            mobileMenu?.classList.remove("open");
            menuOverlay?.classList.remove("open");
            mobileMenuToggle?.classList.remove("open");
        }

        function openMenu() {
            mobileMenu?.classList.add("open");
            menuOverlay?.classList.add("open");
            mobileMenuToggle?.classList.add("open");
        }

        mobileMenuToggle?.addEventListener("click", () => {
            if (mobileMenu?.classList.contains("open")) {
                closeMenu();
            } else {
                openMenu();
            }
            mobileMenuToggle?.blur();
        });

        menuOverlay?.addEventListener("click", closeMenu);

        copyRSS?.addEventListener("click", () => {
            navigator.clipboard.writeText(window.location.origin + "/rss.xml");
        });

        mobileThemeToggle?.addEventListener("click", () => {
            const element = document.documentElement;
            element.classList.toggle("dark");
            const isDark = element.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
    }

    setupMobileMenu();
    document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
