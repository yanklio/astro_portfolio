---
import type { BlogPost } from "../data/blog";
import BlogCard from "./BlogCard.astro";

interface Props {
    posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="blog-list">
    {posts.map((post) => <BlogCard post={post} />)}
</div>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding-top: 4rem;
        padding-bottom: 8rem;
    }
</style>
