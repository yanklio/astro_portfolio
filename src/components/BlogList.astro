---
import type { CollectionEntry } from "astro:content";
import BlogCard from "./BlogCard.astro";

const { posts } = Astro.props;
---

<div class="blog-list">
    {posts.map((post: CollectionEntry<"blog">) => <BlogCard post={post} />)}
</div>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding-top: 2rem;
    }

</style>
