---
const { text } = Astro.props;
---

<span class="tag">
    #{text}
</span>

<style>
    .tag {
        background-color: var(--bg2);
        color: var(--fg1);
        padding: 0.4rem 0.8rem;
        font-size: 0.9rem;
        border: 2px solid var(--fg2);
        box-shadow: 2px 2px 0px 0px var(--fg3);
        white-space: nowrap;
        text-decoration: none;
        display: inline-block;
        user-select: none;
    }
</style>
