---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout pageTitle="yanklio/about" pageDescription="Full-Stack Developer at Viseven. Experienced with TypeScript, React, Next.js, Node.js, Python, and more.">
    <div class="hero-center">
        <div class="simple-card paper-border paper-shadow">
            <div class="card-header">
                <span class="prompt">&gt;</span>
                <span class="section-number">01</span>
                <span class="label">ABOUT_ME</span>
            </div>
            <h1 class="title">Yaroslav</h1>
            <h2 class="subtitle">Full-Stack Dev @ Viseven</h2>
            <div class="divider"></div>
            <p class="bio-text">
                Hi! 👋 I'm Yaroslav, a Full-Stack Developer with a few years of
                experience. I'm mostly interested in a broad variety of web
                technologies. During my journey, I've worked with many tools 🛠️,
                including TypeScript, React (with the popular framework
                Next.js), Node.js, and Python, and that's not all. There is
                always room to grow 🌱, but I believe in practical solutions that
                actually help people
            </p>
        </div>

        <div class="simple-card paper-border paper-shadow">
            <div class="card-header">
                <span class="prompt">&gt;</span>
                <span class="section-number">02</span>
                <span class="label">SKILLS</span>
            </div>
            <div class="skills-container">
                <div class="skill-category">
                    <span class="category-name">Frontend</span>
                    <div class="skills-list">
                        <span class="skill-item">HTML/CSS</span>
                        <span class="skill-item">JavaScript (ES6+)</span>
                        <span class="skill-item">TypeScript</span>
                        <span class="skill-item">React</span>
                        <span class="skill-item">Next.js</span>
                        <span class="skill-item">Vue.js</span>
                        <span class="skill-item">Angular</span>
                    </div>
                </div>

                <div class="skill-category">
                    <span class="category-name">Backend</span>
                    <div class="skills-list">
                        <span class="skill-item">Python</span>
                        <span class="skill-item">Django</span>
                        <span class="skill-item">Node.js</span>
                        <span class="skill-item">Express</span>
                        <span class="skill-item">Nest.js</span>
                    </div>
                </div>

                <div class="skill-category">
                    <span class="category-name">Cloud & Infrastructure</span>
                    <div class="skills-list">
                        <span class="skill-item">PostgreSQL</span>
                        <span class="skill-item"
                            >AWS (ECS, S3, RDS, CF, IAM)</span
                        >
                        <span class="skill-item">Terraform</span>
                        <span class="skill-item">Docker</span>
                        <span class="skill-item">CI/CD</span>
                    </div>
                </div>

                <div class="skill-category">
                    <span class="category-name">AI & Tools</span>
                    <div class="skills-list">
                        <span class="skill-item">Linux</span>
                        <span class="skill-item">Git</span>
                        <span class="skill-item">LangChain</span>
                        <span class="skill-item">OpenCode</span>
                        <span class="skill-item">Claude Code</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="simple-card links-card paper-border paper-shadow">
            <div class="card-header">
                <span class="prompt">&gt;</span>
                <span class="section-number">03</span>
                <span class="label">CONTACT</span>
            </div>
            <div class="links-row">
                <a
                    href="https://github.com/yanklio"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="net-link paper-button">Github</a
                >
                <a
                    href="https://www.linkedin.com/in/yaroslav-u/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="net-link paper-button">LinkedIn</a
                >
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .hero-center {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        gap: 1.75rem;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 0;
    }

    .simple-card,
    .links-card {
        background-color: var(--bg);
        display: flex;
        flex-direction: column;
        min-height: 12rem;
        padding: 2.5rem;
        width: 100%;
        position: relative;
    }



    .card-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding: 0;
        background-color: transparent;
    }

    .prompt {
        color: var(--fg3);
        font-size: 0.85rem;
        font-weight: 900;
    }

    .section-number {
        color: var(--fg2);
        font-size: 0.85rem;
        font-weight: 900;
    }

    .label {
        margin: 0;
        padding: 0;
        background-color: transparent;
        color: var(--fg4);
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .links-row {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        width: 100%;
        margin-top: 1rem;
    }

    @media (max-width: 600px) {
        .simple-card,
        .links-card {
            transform: none;
            padding: 1.5rem;
        }

        .card-header {
            margin-bottom: 1rem;
        }

        .label {
            margin: 0;
        }

        .links-row {
            flex-direction: column;
        }
    }

    .title {
        font-size: 3.5rem;
        line-height: 1;
        margin: 0 0 0.5rem 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        color: var(--fg1);
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--fg2);
        margin: 0 0 1.5rem 0;
        font-weight: normal;
    }

    .divider {
        width: 100%;
        height: 2px;
        background-color: var(--fg3);
        margin: 1.5rem 0;
    }

    .bio-text {
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--fg1);
        margin: 0;
        max-width: 70ch;
    }

    .skills-container {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .skill-category {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .category-name {
        font-size: 0.9rem;
        color: var(--fg2);
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding-bottom: 0.55rem;
        border-bottom: 2px solid light-dark(var(--bg2), var(--bg3));
    }

    .skills-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .skill-item {
        background-color: var(--bg2);
        color: var(--fg1);
        padding: 0.4rem 0.8rem;
        font-size: 0.9rem;
        border: 2px solid var(--fg2);
        box-shadow: 2px 2px 0px 0px var(--fg3);
    }

    .net-link {
        flex: 1;
        text-decoration: none;
        color: var(--fg1);
        font-weight: 700;
        text-transform: uppercase;
        padding: 1rem;
        font-size: 1.1rem;
    }

    @media (max-width: 700px) {
        .skills-container {
            grid-template-columns: 1fr;
        }
    }
</style>
