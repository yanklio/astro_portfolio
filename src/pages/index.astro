---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, socialLinks, toolboxGroups } from "../config/site";
---

<BaseLayout
    pageDescription="Personal website and notes by Yaroslav, a full-stack developer working with TypeScript, React, Node.js, and Python."
>
    <div class="home-page">
        <section class="intro" aria-labelledby="intro-title">
            <div class="intro-copy">
                <h1 id="intro-title">{site.name}</h1>
                <p class="role">Full-stack developer</p>
                <p class="intro-description">
                    I’m drawn to interesting technical products and the systems behind them. Most of my experience is in
                    the JavaScript ecosystem, working across both frontend and backend. I’m also moving deeper into Java
                    world and mastering cloud infrastructure and DevOps<br /><br />Based in Poznań, PL and open to
                    remote work too
                </p>
