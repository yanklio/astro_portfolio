        </section>

        <section class="home-section" aria-labelledby="toolbox-title">
            <header class="section-heading">

                <h2 id="toolbox-title">Toolbox</h2>
            </header>
            <div class="skills-table">
                {toolboxGroups.map(({ label, tools }) => (
                    <div class="skill-row"><span>{label}</span><p>{tools}</p></div>
                ))}
            </div>
        </section>

        <section class="contact-block" aria-labelledby="links-title">
            <h2 id="links-title">You can find me where</h2>
            <div class="contact-row">
                {socialLinks.map(({ href, label }) => (
                    <a href={href} target="_blank" rel="noopener noreferrer" class="paper-button contact-link">{label} <span>↗</span></a>
                ))}
            </div>
        </section>
