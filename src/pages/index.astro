---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout
    pageTitle="yanklio/about"
    pageDescription="Full-Stack Developer at Viseven. Experienced with TypeScript, React, Next.js, Node.js, Python, and more."
>
    <div class="page">

        <!-- ── About ───────────────────────────────── -->
        <div class="card paper-border paper-shadow">
            <div class="card-body">
                <span class="section-label">// about</span>
                <h1 class="hero-name">Yaroslav</h1>
                <p class="hero-role">Full-Stack Dev <span class="accent">@</span> Viseven</p>
                <div class="rule"></div>
                <p class="bio">
                    Hi! 👋 I'm Yaroslav, a Full-Stack Developer with a few years of
                    experience. Mostly interested in a broad variety of web technologies —
                    TypeScript, React (with Next.js), Node.js, Python, and more.
                    There is always room to grow 🌱, but I believe in practical solutions
                    that actually help people.
                </p>
            </div>
        </div>

        <!-- ── Skills ─────────────────────────────── -->
        <div class="card paper-border paper-shadow">
            <div class="card-body">
                <span class="section-label">// skills</span>
                <div class="skills-table">

                    <div class="skill-row">
                        <span class="skill-cat">Frontend</span>
                        <div class="skill-pills">
                            <span class="pill">HTML/CSS</span>
                            <span class="pill">JavaScript</span>
                            <span class="pill">TypeScript</span>
                            <span class="pill">React</span>
                            <span class="pill">Next.js</span>
                            <span class="pill">Vue.js</span>
                            <span class="pill">Angular</span>
                        </div>
                    </div>

                    <div class="skill-row">
                        <span class="skill-cat">Backend</span>
                        <div class="skill-pills">
                            <span class="pill">Python</span>
                            <span class="pill">Django</span>
                            <span class="pill">Node.js</span>
                            <span class="pill">Express</span>
                            <span class="pill">Nest.js</span>
                        </div>
                    </div>

                    <div class="skill-row">
                        <span class="skill-cat">Cloud</span>
                        <div class="skill-pills">
                            <span class="pill">PostgreSQL</span>
                            <span class="pill">AWS (ECS, S3, RDS)</span>
                            <span class="pill">Terraform</span>
                            <span class="pill">Docker</span>
                            <span class="pill">CI/CD</span>
                        </div>
                    </div>

                    <div class="skill-row">
                        <span class="skill-cat">AI &amp; Tools</span>
                        <div class="skill-pills">
                            <span class="pill">Linux</span>
                            <span class="pill">Git</span>
                            <span class="pill">LangChain</span>
                            <span class="pill">OpenCode</span>
                            <span class="pill">Claude Code</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ── Contact ────────────────────────────── -->
        <div class="card paper-border paper-shadow">
            <div class="card-body">
                <span class="section-label">// links</span>
                <div class="contact-row">
                    <a
                        href="https://github.com/yanklio"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn paper-button"
                    >Github</a>
                    <a
                        href="https://www.linkedin.com/in/yaroslav-u/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-btn paper-button"
                    >LinkedIn</a>
                </div>
            </div>
        </div>

    </div>
</BaseLayout>

<style>
    .page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 680px;
        margin: 0 auto;
        padding: 2rem 0;
    }

    /* ── Card ──────────────────────────────────────── */
    .card {
        background-color: var(--bg);
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow: hidden;
    }

    /* ── Body ──────────────────────────────────────── */
    .card-body {
        padding: 2rem 2.25rem;
    }

    /* ── Hero ──────────────────────────────────────── */
    .hero-name {
        font-size: clamp(2.75rem, 8vw, 5rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 1;
        margin: 0 0 0.45rem 0;
        color: var(--fg1);
    }

    .hero-role {
        font-size: 1.1rem;
        color: var(--fg3);
        margin: 0 0 1.75rem 0;
    }

    .accent {
        color: var(--orange);
        font-weight: 700;
    }

    .rule {
        width: 40px;
        height: 3px;
        background-color: var(--orange);
        margin-bottom: 1.25rem;
    }

    .bio {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--fg2);
        margin: 0;
    }

    /* ── Skills ────────────────────────────────────── */
    .skills-table {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .skill-row {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .skill-cat {
        flex: 0 0 80px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--fg4);
        padding-top: 0.4rem;
        white-space: nowrap;
    }

    .skill-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .pill {
        background-color: var(--bg2);
        color: var(--fg1);
        padding: 0.3rem 0.65rem;
        font-size: 0.875rem;
        border: 2px solid light-dark(var(--fg2), var(--bg3));
        box-shadow: 2px 2px 0px 0px light-dark(var(--fg3), var(--bg4));
        white-space: nowrap;
    }

    /* ── Section label ─────────────────────────────── */
    .section-label {
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--orange-dim);
        letter-spacing: 1px;
        margin-bottom: 1.25rem;
    }

    /* ── Contact ───────────────────────────────────── */
    .contact-row {
        display: flex;
        gap: 1rem;
    }

    .contact-btn {
        padding: 0.75rem 2rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ── Responsive ────────────────────────────────── */
    @media (max-width: 600px) {
        .card-body {
            padding: 1.5rem;
        }

        .skill-row {
            flex-direction: column;
            gap: 0.4rem;
        }

        .skill-cat {
            flex: none;
            padding-top: 0;
        }

        .contact-row {
            flex-direction: column;
            align-items: stretch;
        }

        .contact-btn {
            text-align: center;
        }
    }
</style>
