---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Not found">
    <section class="not-found" aria-labelledby="not-found-title">
        <div class="error-code">404</div>
        <div class="error-copy">
            <p class="page-kicker">Route unavailable</p>
            <h1 id="not-found-title">Nothing here.</h1>
            <p>The page you requested does not exist, or it has moved somewhere more useful.</p>
            <a class="paper-button" href="/">Back to index <span>←</span></a>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found { align-items: stretch; display: grid; grid-template-columns: minmax(13rem, 0.6fr) 1fr; margin: 0 auto; max-width: 1080px; min-height: 62vh; padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
    .error-code { align-items: center; background: var(--accent); border: 2px solid var(--line); color: var(--bg); display: flex; font-size: clamp(5rem, 14vw, 11rem); font-weight: 700; justify-content: center; letter-spacing: -0.14em; line-height: 0.7; }
    .error-copy { border: 2px solid var(--line); border-left: 0; display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4rem); }
    .error-copy h1 { font-size: clamp(2.8rem, 7vw, 6rem); font-weight: 700; letter-spacing: -0.1em; line-height: 0.8; margin: 1.25rem 0; }
    .error-copy > p:not(.page-kicker) { color: var(--fg2); line-height: 1.75; margin: 0 0 1.75rem; max-width: 30rem; }
    .error-copy a { align-self: flex-start; font-size: 0.78rem; font-weight: 700; gap: 0.8rem; padding: 0.8rem 0.95rem; text-decoration: none; text-transform: uppercase; }
    .error-copy a span { color: var(--accent); font-size: 1.05rem; }
    @media (max-width: 520px) {
        .not-found { grid-template-columns: 1fr; min-height: 0; }
        .error-code { min-height: 11rem; }
        .error-copy { border-left: 2px solid var(--line); border-top: 0; }
    }
</style>
